+import 接続.ARC2.HDS接続 as hds
 from 接続.ARC2.HDS接続 import 課題を解く
 
 
@@ -21,3 +22,48 @@ def test_候補収集は通常出力の状態を変えず診断情報だけを
     first_candidate = diagnostic_row["candidate_predictions"][0]
