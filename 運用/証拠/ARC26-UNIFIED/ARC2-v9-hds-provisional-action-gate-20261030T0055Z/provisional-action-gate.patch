+
+
+def test_HDS未採用のtrain_fit候補は真理状態を変えず暫定行動候補へ出す(monkeypatch):
+    class 候補群:
+        def 第一候補(self, grid, defaults):
+            del defaults
+            return grid, {
+                "generator": "symbolic_program_induction",
+                "program_source_sha256": "a" * 64,
+                "rank": 1,
+                "train_fit": True,
+                "program": "identity",
+            }
+
+        def 第二候補(self, grid, defaults):
+            del grid, defaults
+            return None, {
+                "generator": "symbolic_program_induction",
+                "program_source_sha256": "a" * 64,
+                "rank": 2,
+                "train_fit": False,
+            }
+
+    monkeypatch.setattr(hds, "汎用プログラム帰納候補群", lambda train: 候補群())
+    task = {
+        "train": [{"input": [[1, 0], [0, 0]], "output": [[1, 0], [0, 0]]}],
+        "test": [{"input": [[2, 0], [0, 0]]}],
+    }
+
+    ordinary = 課題を解く(task, [])
+    diagnostic = 課題を解く(task, [], 候補収集=True)
+
+    ordinary_row = ordinary["results"][0]
+    diagnostic_row = diagnostic["results"][0]
+    assert diagnostic_row.get("answer") == ordinary_row.get("answer")
+    provisional = [
+        candidate
+        for candidate in diagnostic_row["candidate_predictions"]
+        if candidate["family"] == "ARC汎用プログラム帰納_1"
+    ]
+    assert len(provisional) == 1
+    assert provisional[0]["answer"] == [[2, 0], [0, 0]]
+    assert provisional[0]["hds_admitted"] is False
+    assert provisional[0]["provisional"] is True
+    assert provisional[0]["evidence"]["train_fit"] is True
