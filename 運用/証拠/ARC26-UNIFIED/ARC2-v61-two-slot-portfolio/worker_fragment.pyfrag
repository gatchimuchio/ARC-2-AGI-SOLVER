            portfolio候補 = None
            portfolio診断 = {
                "policy_id": _PORTFOLIO_POLICY_ID,
                "eligible": False,
                "eligibility_reason": "outside_test_rows",
                "selected": False,
                "sources": [],
                "extra_seconds": 0.0,
                "targets_or_task_ids_received": False,
            }
            hds一次保留 = 元行.get("answer") is None if isinstance(元行, dict) else False
            if 位置 < len(課題["test"]):
                portfolio入力 = 課題["test"][位置]["input"]
                legacy予測 = 第一候補 if 候補対 else 元行.get("answer")
                legacy第一 = legacy予測 if 格子か(legacy予測) else portfolio入力
                legacy第二 = 第二候補 if 格子か(第二候補) and 第二候補 != legacy第一 else legacy第一
                if not hds一次保留:
                    portfolio診断["eligibility_reason"] = "hds_primary_answer_present"
                elif 候補対:
                    portfolio診断["eligibility_reason"] = "legacy_candidate_pair_present"
                elif legacy第一 != portfolio入力:
                    portfolio診断["eligibility_reason"] = "legacy_nonidentity_attempt1_present"
                elif legacy第二 == portfolio入力:
                    portfolio診断["eligibility_reason"] = "v61_attempt2_is_input_copy"
                else:
                    portfolio候補, portfolio診断 = _portfolio_select_attempt1(
                        portfolio入力, legacy第二,
                        (
                            ("teacher_pair_consensus", "existing_teacher_pair_consensus_min1_for_single_pair_else2", lambda: 物体抽出候補器.teacher_pair_consensus_candidate(portfolio入力)),
                            ("object_extraction", "existing_object_models_fit_current_train", lambda: 物体抽出候補器.candidate(portfolio入力)),
                            ("object_outlier", "existing_object_outlier_models_fit_current_train", lambda: 物体抽出候補器.outlier_candidate(portfolio入力)),
                            ("object_palette", "existing_object_palette_models_fit_current_train", lambda: 物体抽出候補器.palette_candidate(portfolio入力)),
                            ("local_cell_context", "existing_local_context_model_fit_current_train", lambda: 局所近傍候補器.候補(portfolio入力, {})),
                            ("simple_unique_transform", "unique_transform_validated_on_current_train", lambda: (unique_candidate(課題["train"], portfolio入力), {})),
                            ("composite_geometry", "existing_composite_program_fit_current_train", lambda: 複合幾何候補器.候補(portfolio入力, {})),
                        ),
                        格子か,
                    )
