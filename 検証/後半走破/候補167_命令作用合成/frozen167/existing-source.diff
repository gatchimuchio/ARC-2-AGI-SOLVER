+# All nine nontrivial D4 subgroups, not a demonstration-selected subset.
+ORBIT_GROUPS = (
+    ('identity', 'rot180'),
+    ('identity', 'flip_h'), ('identity', 'flip_v'),
+    ('identity', 'transpose'), ('identity', 'anti_transpose'),
+    ('identity', 'rot90', 'rot180', 'rot270'),
+    ('identity', 'rot180', 'flip_h', 'flip_v'),
+    ('identity', 'rot180', 'transpose', 'anti_transpose'),
+    old085.TRANSFORMS)
+ORBIT_ACTIONS = tuple(
+    ('orbit_segments', transform, group, geometry, endpoints)
+    for transform in old085.TRANSFORMS for group in ORBIT_GROUPS
+    for geometry in ('axis', 'octilinear')
+    for endpoints in ('all', 'marker_incident'))
+
+
+def orbit_segment_action(grid, blank, ink, model):
+    """Color-consistent nonblank orbit union, then existing straight segments."""
+    if model not in ORBIT_ACTIONS:
+        return None, {'failure': 'outside_finite_action_inventory'}
+    source = transform_grid_by_name(grid, model[1])
+    images = [transform_grid_by_name(source, transform)
+              for transform in model[2]]
+    shape = (len(source), len(source[0]))
+    if any((len(image), len(image[0])) != shape for image in images):
+        return None, {'failure': 'orbit_shape_disagreement'}
+    merged = []
+    for r in range(shape[0]):
+        row = []
+        for c in range(shape[1]):
+            colors = {image[r][c] for image in images} - {blank}
+            if len(colors) > 1:
+                return None, {'failure': 'orbit_color_disagreement',
+                              'cell': (r, c), 'colors': sorted(colors)}
+            row.append(next(iter(colors)) if colors else blank)
+        merged.append(row)
+    segment_model = ('segments', 'identity', model[3], model[4])
+    output = old085.act(merged, blank, ink, segment_model)
+    witness = {'orbit_group': model[2], 'transform': model[1],
+               'segment_model': segment_model, 'orbit_union': merged}
+    if output is None:
+        return None, dict(witness, failure='existing_segment_contract_rejected')
+    return output, witness
+
