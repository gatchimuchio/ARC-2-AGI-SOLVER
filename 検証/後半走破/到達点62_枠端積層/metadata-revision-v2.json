  "corrections": {
    "作用": {
      "before": "cue導出proper C4回転後の全cropを、最大crop幅のgapless縦stackへexact/floor/ceil規約で中央配置する。余白はその入力roleの背景色。guideのみ消費し、全payloadを保持する。",
      "after": "cue導出proper C4回転後の全cropを、最大crop幅のgapless縦stackへexact/floor/ceil規約で中央配置する。全foregroundと各完全crop内部を保持し、成分間の背景paddingは積層結果に合わせて再構成する。guideを出力から除き、再構成する余白にはその入力roleの背景色を用いる。"
    },
    "保存条件": {
      "before": "全foreground所有と完全crop内の他成分混入を検査し、crop全色count・foreground色count・穴数・全体foregroundを保存する。入力、教師、immutable保持6モデルは不変。旧67台帳と068既公開bytesは不変。",
      "after": "全foreground所有と完全crop内の他成分混入を検査し、crop全色count・foreground色count・穴数・全体foregroundを保存する。各完全crop内部は共通proper C4変換で保持するが、component bbox外の成分間背景paddingは保存対象ではなく積層結果に合わせて再構成する。guideは出力から除く。入力、教師、immutable保持6モデルは不変。旧67台帳と068既公開bytesは不変。"
    }
  },
